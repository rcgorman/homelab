[Unit]
Description=Keycloak identity provider
Requires=keycloak-database.service
After=keycloak-database.service

[Container]
ContainerName=keycloak
Image=quay.io/keycloak/keycloak:26.8.2
UserNS=auto
Network=keycloak.network
PublishPort=18081:8080
Exec=start
Environment=TZ=America/New_York
Environment=KC_DB=postgres
Environment=KC_DB_URL_HOST=database
Environment=KC_DB_URL_DATABASE=keycloak
Environment=KC_DB_USERNAME=keycloak
Environment=KC_HOSTNAME=https://auth.gormantech.com
Environment=KC_HTTP_ENABLED=true
Environment=KC_PROXY_HEADERS=xforwarded
Environment=KC_TRUSTSTORE_PATHS=/opt/keycloak/conf/truststores/ipa-ca.crt
Volume=/srv/quadlet/keycloak/ipa-ca.crt:/opt/keycloak/conf/truststores/ipa-ca.crt:ro,Z
Secret=keycloak_db_password,type=env,target=KCRAW_DB_PASSWORD

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
