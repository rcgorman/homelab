[Unit]
Description=OpenCloud
RequiresMountsFor=/mnt/opencloud/data
AssertPathIsMountPoint=/mnt/opencloud/data

[Container]
ContainerName=opencloud
Image=docker.io/opencloudeu/opencloud-rolling:9.2.0
Network=opencloud.network
UserNS=auto:uidmapping=3001:3001:1,gidmapping=3001:3001:1
User=3001
Group=3001
DNS=10.6.13.1
Entrypoint=/bin/sh
Exec= -ec "if [ ! -s /etc/opencloud/opencloud.yaml ]; then if [ -e /var/lib/opencloud/idm/idm.boltdb ]; then echo 'Existing OpenCloud IDM data requires its matching opencloud.yaml' >&2; exit 1; fi; opencloud init; fi; exec opencloud server"
PublishPort=9200:9200
Environment=TZ=America/New_York
Environment=OC_URL=https://cloud.gormantech.com
Environment=OC_LOG_LEVEL=info
Environment=OC_LOG_COLOR=false
Environment=OC_LOG_PRETTY=false
Environment=PROXY_TLS=false
Environment=PROXY_HTTP_ADDR=0.0.0.0:9200
Environment=OC_INSECURE=false
Environment=PROXY_ENABLE_BASIC_AUTH=false
Environment=IDM_CREATE_DEMO_USERS=false
Environment=OC_DEFAULT_LANGUAGE=en
Environment=OC_OIDC_ISSUER=https://auth.gormantech.com/realms/internal
Environment=IDP_DOMAIN=auth.gormantech.com
Environment=OC_EXCLUDE_RUN_SERVICES=idp
Environment=PROXY_OIDC_ACCESS_TOKEN_VERIFY_METHOD=jwt
Environment=PROXY_OIDC_REWRITE_WELLKNOWN=true
Environment=PROXY_CSP_CONFIG_FILE_LOCATION=/etc/opencloud/csp.yaml
Environment=WEB_OPTION_ACCOUNT_EDIT_LINK_HREF=https://auth.gormantech.com/realms/internal/account
Environment=OC_LDAP_SERVER_WRITE_ENABLED=true
Environment=PROXY_AUTOPROVISION_ACCOUNTS=true
Environment=PROXY_USER_OIDC_CLAIM=sub
Environment=PROXY_AUTOPROVISION_CLAIM_USERNAME=sub
Environment=PROXY_USER_CS3_CLAIM=username
Environment=GRAPH_USERNAME_MATCH=none
Environment=PROXY_ROLE_ASSIGNMENT_DRIVER=oidc
Environment=GRAPH_ASSIGN_DEFAULT_USER_ROLE=false
Environment=SETTINGS_SETUP_DEFAULT_ASSIGNMENTS=false
Volume=opencloud-config.volume:/etc/opencloud:U
Volume=/mnt/opencloud/data:/var/lib/opencloud
SecurityLabelDisable=true
Secret=opencloud_admin_password,type=env,target=IDM_ADMIN_PASSWORD

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
