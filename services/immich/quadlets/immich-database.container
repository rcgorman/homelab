[Unit]
Description=Immich PostgreSQL (VectorChord)

[Container]
ContainerName=immich_postgres
Image=ghcr.io/immich-app/postgres:16-vectorchord0.4.3-pgvectors0.2.0@sha256:1a078b237c1d9b420b0ee59147386b4aa60d3a07a8e6a402fc84a57e41b043a4
UserNS=auto
Network=immich.network
NetworkAlias=database
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_DB=immich
Environment=POSTGRES_INITDB_ARGS=--data-checksums
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/immich_db_password
Volume=immich-postgres.volume:/var/lib/postgresql/data:U
Secret=immich_db_password,type=mount,target=immich_db_password
ShmSize=128m
HealthCmd=pg_isready -U postgres -d immich
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
