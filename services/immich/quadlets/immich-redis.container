[Unit]
Description=Immich Valkey

[Container]
ContainerName=immich_redis
Image=docker.io/valkey/valkey:9@sha256:1c2b25b09f354c66fe994733acdf12fcfd4bdf6f3bd92b88a93a70378d884056
UserNS=auto
Network=immich.network
NetworkAlias=redis
HealthCmd=valkey-cli ping
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
