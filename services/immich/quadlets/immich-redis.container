[Unit]
Description=Immich Valkey

[Container]
ContainerName=immich_redis
Image=docker.io/valkey/valkey:9@sha256:169567d6288e5f08aa141847c0c3e0864a32e727682ca6f052a20567c7103ef8
UserNS=auto
Network=immich.network
NetworkAlias=redis
HealthCmd=valkey-cli ping
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
