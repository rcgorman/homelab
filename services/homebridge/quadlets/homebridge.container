[Unit]
Description=Homebridge

[Container]
ContainerName=homebridge
Image=docker.io/homebridge/homebridge:2026-11-10
Network=host
UserNS=auto
Environment=TZ=America/New_York
Volume=homebridge-data.volume:/homebridge:U

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target

