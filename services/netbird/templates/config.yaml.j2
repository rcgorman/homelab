server:
  listenAddress: ":80"
  exposedAddress: "https://netbird.gormantech.com:443"
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: {{ vault_netbird_auth_secret | to_json }}
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "https://netbird.gormantech.com/oauth2"
    signKeyRefreshEnabled: true
    dashboardRedirectURIs:
      - "https://netbird.gormantech.com/nb-auth"
      - "https://netbird.gormantech.com/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "172.99.0.2/32"
    trustedPeers:
      - "172.99.0.2/32"

  store:
    engine: "sqlite"
    encryptionKey: {{ vault_netbird_store_encryption_key | to_json }}
