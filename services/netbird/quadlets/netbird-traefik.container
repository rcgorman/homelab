[Unit]
Description=Traefik for NetBird
Requires=netbird-crowdsec.service
After=netbird-crowdsec.service

[Container]
ContainerName=netbird-traefik
Image=docker.io/library/traefik:v3.7.19
UserNS=auto
Network=netbird.network
PublishPort=443:443
IP=172.99.0.2
Volume=netbird-traefik-letsencrypt.volume:/letsencrypt:idmap
Volume=/srv/quadlet/netbird/traefik-dynamic.yaml:/etc/traefik/dynamic.yaml:ro,Z
Volume=/srv/quadlet/netbird/traefik-logs:/var/log/traefik:rw,z,idmap
Environment=TRAEFIK_ACCESSLOG_FILEPATH=/var/log/traefik/access.log
Environment=TRAEFIK_LOG_LEVEL=INFO
Environment=TRAEFIK_ACCESSLOG=true
Environment=TRAEFIK_PROVIDERS_FILE_FILENAME=/etc/traefik/dynamic.yaml
Environment=TRAEFIK_ENTRYPOINTS_WEBSECURE_ADDRESS=:443
Environment=TRAEFIK_ENTRYPOINTS_WEBSECURE_ALLOWACMEBYPASS=true
Environment=TRAEFIK_ENTRYPOINTS_WEBSECURE_HTTP_ALIASHEADERSSTRATEGY=delete
Environment=TRAEFIK_ENTRYPOINTS_WEBSECURE_TRANSPORT_RESPONDINGTIMEOUTS_READTIMEOUT=0
Environment=TRAEFIK_ENTRYPOINTS_WEBSECURE_TRANSPORT_RESPONDINGTIMEOUTS_WRITETIMEOUT=0
Environment=TRAEFIK_ENTRYPOINTS_WEBSECURE_TRANSPORT_RESPONDINGTIMEOUTS_IDLETIMEOUT=0
Environment=TRAEFIK_SERVERSTRANSPORT_FORWARDINGTIMEOUTS_RESPONSEHEADERTIMEOUT=0s
Environment=TRAEFIK_SERVERSTRANSPORT_FORWARDINGTIMEOUTS_IDLECONNTIMEOUT=0s
Environment=TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_EMAIL=ryan@gormantech.com
Environment=TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_STORAGE=/letsencrypt/acme.json
Environment=TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_TLSCHALLENGE=true
Environment=TRAEFIK_EXPERIMENTAL_PLUGINS_BOUNCER_MODULENAME=github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
Environment=TRAEFIK_EXPERIMENTAL_PLUGINS_BOUNCER_VERSION=v1.7.1
Secret=crowdsec_bouncer_api_key,type=mount,target=/run/secrets/crowdsec_bouncer_api_key

[Service]
ExecStartPre=/usr/bin/podman healthcheck run netbird-crowdsec
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target

